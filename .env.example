HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
HYPERTESTNET_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm

# keystore name, never a raw key: cast wallet new ~/.foundry/keystores coldcascade-deployer
DEPLOYER_ACCOUNT=coldcascade-deployer
# The address that keystore holds. Set it so ./script/mainnet.sh can run its preflight — which is
# all reads — without asking for the password.
DEPLOYER=

# The canonical desk's pair on chain 999. Already the default in script/base/Addresses.sol, which
# picks the real tokens on 999 and the mintable ones everywhere else; set these only to override.
# UBTC has 8 decimals, USD₮0 has 6, and ./script/mainnet.sh reads both back before it sends.
# BASE_TOKEN=0x9FDBdA0A5e284c32744D2f17Ee5c74B284993463
# QUOTE_TOKEN=0xB8CE59FC3717ada4C02eaDF9682A9e934F625ebb

# What Ship.s.sol moves into the canonical desk and into the control, in raw token units:
# 0.000125 UBTC (~$10) and 10 USD₮0. This is real money on 999, and the control ships from the
# deployer's own EOA and leaves Aqua an unlimited approval on both tokens so it can pull later
# fills — so deploy from a key that holds only what you are willing to have shipped.
CANONICAL_BASE=12500
CANONICAL_QUOTE=10000000

SUBGRAPH_URL=

# ---- Privy ----
# The app id is public: it ships in every client bundle and Privy gates the app on an allowlist of
# origins instead. `./script/appvendor.sh` reads it from here and writes `app/privy.json`.
PRIVY_APP_ID=
# Optional; only if you created a client under Settings → Clients.
PRIVY_CLIENT_ID=

# The app SECRET is server-side only. It belongs in Vercel's environment variables and nowhere in
# this repository — `.vercelignore` keeps `.env` off the host, and nothing in `app/` reads it.
PRIVY_APP_SECRET=

# The gas faucet. A judge signs in with an email address and gets a wallet holding no HYPE, and
# Privy's gas sponsorship does not cover chain 999 — so `api/faucet.mjs` drips 0.002 HYPE, once per
# Privy user. It signs with a Privy server wallet held under a policy that allows
# `eth_sendTransaction` on chain 999 up to that amount and nothing else; `keeper/policy.json` is
# that policy as Privy returns it. Create both with the REST API, then fund the address.
PRIVY_FAUCET_WALLET_ID=
PRIVY_FAUCET_POLICY_ID=
PRIVY_FAUCET_ADDRESS=

# The owner key for the faucet wallet, generated by ./script/faucet-owner.sh. A Privy policy is NOT
# enforced on a wallet whose owner_id is null — the app secret alone is full authority over it, which
# was measured, not assumed. With an owner set, every wallet write must also carry a
# privy-authorization-signature from this key. Vercel needs it too, under the same name.
PRIVY_AUTHORIZATION_KEY=

# The hedge operator. `DeskAccount.armHedge` takes an operator address: the owner authorises the
# ceiling on a device and a scoped key fires `cover()` inside it, and that key can move no funds —
# `cover` transfers nothing and every other call on the account is onlyOwner. These four are that
# key, as a second Privy server wallet under keeper/hedge-policy.json: cover() only, one desk only,
# chain 999 only, value 0 only. `./script/hedge-operator.sh` creates all of it and prints them;
# `node script/hedge-check.mjs` asserts the refusals; `node script/cover.mjs` is what fires.
#
# This wallet is not deployed: none of these belong in Vercel's environment. The faucet is a public
# endpoint and has to run in the cloud; the hedge runs from a cadence on the maker's own machine,
# which is the only place the key needs to exist.
PRIVY_HEDGE_WALLET_ID=
PRIVY_HEDGE_POLICY_ID=
PRIVY_HEDGE_OPERATOR=
PRIVY_HEDGE_AUTHORIZATION_KEY=

# The cadences do not share an endpoint with the console. rpc.hyperliquid.xyz is the public node
# every browser on the page uses and it rate-limits; a throttled keeper retries, a throttled page
# hangs at "connecting to HyperEVM…". ARCHIVE_RPC_URL is separate again because the public node
# accepts a past block tag and returns *current* state, so a reserve read there is silently wrong.
KEEPER_RPC_URL=https://rpc.hypurrscan.io
POKE_RPC_URL=https://rpc.hypurrscan.io
ARCHIVE_RPC_URL=https://hyperliquid.drpc.org
