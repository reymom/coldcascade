HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
HYPERTESTNET_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm

# keystore name, never a raw key: cast wallet new ~/.foundry/keystores coldcascade-deployer
DEPLOYER_ACCOUNT=coldcascade-deployer
# The address that keystore holds. Set it so ./script/mainnet.sh can run its preflight — which is
# all reads — without asking for the password.
DEPLOYER=

# The canonical desk's pair on chain 999. Already the default in script/base/Addresses.sol, which
# picks the real tokens on 999 and the mintable ones everywhere else; set these only to override.
# UBTC has 8 decimals, USD₮0 has 6, and ./script/mainnet.sh reads both back before it sends.
# BASE_TOKEN=0x9FDBdA0A5e284c32744D2f17Ee5c74B284993463
# QUOTE_TOKEN=0xB8CE59FC3717ada4C02eaDF9682A9e934F625ebb

# What Ship.s.sol moves into the canonical desk and into the control, in raw token units:
# 0.000125 UBTC (~$10) and 10 USD₮0. This is real money on 999, and the control ships from the
# deployer's own EOA and leaves Aqua an unlimited approval on both tokens so it can pull later
# fills — so deploy from a key that holds only what you are willing to have shipped.
CANONICAL_BASE=12500
CANONICAL_QUOTE=10000000

SUBGRAPH_URL=
